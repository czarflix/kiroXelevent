{
  "name": "voicegauntlet",
  "version": "0.1.0",
  "private": true,
  "description": "QA and red-team lab for ElevenLabs voice agents, built with Kiro.",
  "packageManager": "pnpm@10.27.0",
  "pnpm": {
    "overrides": {
      "@hono/node-server": "2.0.10",
      "body-parser": "2.3.0",
      "esbuild": "0.28.1",
      "fast-uri": "3.1.4",
      "hono": "4.12.27",
      "ip-address": "10.1.1",
      "postcss": "8.5.10",
      "qs": "6.15.2",
      "sharp": "0.35.0",
      "ws": "8.21.0"
    }
  },
  "scripts": {
    "dev": "pnpm --filter @voicegauntlet/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "smoke:elevenlabs": "node scripts/smoke-elevenlabs.mjs",
    "smoke:elevenlabs:ws": "node scripts/smoke-elevenlabs-websocket.mjs",
    "agent:ensure": "node scripts/ensure-refundbot-agent.mjs --write-env",
    "smoke:openai": "node scripts/smoke-openai.mjs",
    "demo:audio": "node scripts/generate-demo-replay.mjs",
    "security:scan": "node scripts/security-scan.mjs",
    "mcp": "pnpm --filter @voicegauntlet/mcp dev"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@types/node": "^25.0.0",
    "typescript": "^6.0.3",
    "vite": "8.0.16",
    "vitest": "^4.1.5"
  }
}
